{
    "name": "tosu",
    "version": "4.26.0",
    "type": "module",
    "main": "dist/index.js",
    "bin": "dist/index.js",
    "scripts": {
        "genver": "genversion -es src/_version.js",
        "ts:compile": "rm -rf dist && rolldown -c rolldown.config.mjs",
        "watch": "bun run genver && NODE_ENV=development bun watch.ts",
        "run:dev": "bun run genver && bun run ts:compile && bun dist/index.js",
        "compile:win": "bun run genver && bun run ts:compile && bun build.ts windows",
        "compile:linux": "bun run genver && bun run ts:compile && bun build.ts linux"
    },
    "dependencies": {
        "@tosu/common": "workspace:*",
        "@tosu/ingame-overlay-updater": "workspace:*",
        "@tosu/server": "workspace:*",
        "@tosu/updater": "workspace:*",
        "@tosuapp/lazer-calculator-prebuilt": "0.6.1-20260729-main.0",
        "osu-catch-stable": "^4.0.1",
        "osu-classes": "^3.1.0",
        "osu-mania-stable": "^5.0.1",
        "osu-parsers": "^4.1.7",
        "osu-standard-stable": "^5.0.1",
        "osu-taiko-stable": "^5.0.1",
        "tsprocess": "workspace:*"
    },
    "devDependencies": {
        "genversion": "^3.2.0",
        "rolldown": "^1.2.3",
        "rollup-plugin-copy": "^3.5.0",
        "rosu-pp-js": "4.0.1"
    }
}
