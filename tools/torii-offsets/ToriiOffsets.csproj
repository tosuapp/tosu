<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- net8.0 for torii stable stream / official lazer, net10.0 for torii nova.
         A net10 runtime can also process net8-built clients, but not vice versa. -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>ToriiOffsets</RootNamespace>
    <AssemblyName>torii-offsets</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <LangVersion>latest</LangVersion>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="manifest.json" />
  </ItemGroup>

</Project>
